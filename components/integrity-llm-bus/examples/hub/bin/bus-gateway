#!/usr/bin/python3 -I
# SPDX-License-Identifier: BUSL-1.1
"""bus-gateway <vendor-id> - example forced command for a vendor SSH key on the hub's gateway account.

SSH_ORIGINAL_COMMAND is exactly one protocol word (see OPS). The request is one JSON object on stdin
(at most 300 KB). The gateway executes nothing: it starts no processes, opens no files named by data and
does not use the client environment. It only forwards {v, op, vendor, args} to the hub daemon over its
unix socket; the vendor id comes from the authorized_keys entry (the argument), never from the client.
The daemon accepts a vendor name only from the gateway account's uid (SO_PEERCRED, core.json gateway_user).

Install: copy to a root-owned directory, chmod 0755, set SOCK to core.json "socket", and use
examples/hub/bin/bus-gw-shell as the gateway account's login shell. authorized_keys line per vendor:
  restrict,command="<this path> <vendor-id>" ssh-ed25519 AAAA... <vendor-id>
"""
import json, os, re, socket, sys

OPS = {"send", "poll", "get", "ack", "status", "list-rooms", "watch", "agents-status", "wake-log", "routes", "changes",
       "registry", "room-arbiter", "room-arbiter-set", "vendor-cards", "vendor-heartbeat", "status-batch"}
STREAM = {"watch"}   # event stream (metadata only) until the client closes the connection
SOCK = "/run/llm-bus/core.sock"   # must equal core.json "socket" (RuntimeDirectory=llm-bus in the example unit)
MAX = 300 * 1024


def out(doc, rc):
    sys.stdout.write(json.dumps(doc, ensure_ascii=False) + "\n"); sys.stdout.flush(); os._exit(rc)


def strict(raw):
    def hook(pairs):
        d = {}
        for k, v in pairs:
            if k in d:
                raise ValueError("duplicate key")
            d[k] = v
        return d
    return json.loads(raw.decode("utf-8"), object_pairs_hook=hook)


def main():
    cmd = os.environ.get("SSH_ORIGINAL_COMMAND", "")      # read BEFORE the environment is cleared
    os.environ.clear()                                   # LD_PRELOAD, PATH, LC_* etc. from the client go no further
    if len(sys.argv) != 2 or not re.fullmatch(r"[a-z0-9-]{2,32}", sys.argv[1]):
        out({"ok": False, "error": "gateway misconfigured"}, 2)
    vendor = sys.argv[1]
    if cmd not in OPS:                                   # "bash", "poll; id", "$()", "`id`", scp, sftp ...
        out({"ok": False, "error": "unknown command: only bus protocol words"}, 2)
    raw = sys.stdin.buffer.read(MAX + 1)
    if len(raw) > MAX:
        out({"ok": False, "error": "request too large"}, 2)
    try:
        args = strict(raw) if raw.strip() else {}
    except (UnicodeDecodeError, ValueError):
        out({"ok": False, "error": "invalid JSON (or duplicate key)"}, 2)
    if not isinstance(args, dict):
        out({"ok": False, "error": "args must be a JSON object"}, 2)
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); s.settimeout(60)
    buf = b""
    try:
        s.connect(SOCK)
        s.sendall(json.dumps({"v": 1, "op": cmd, "vendor": vendor, "args": args}, ensure_ascii=False,
                             separators=(",", ":")).encode() + b"\n")
        if cmd in STREAM:
            s.settimeout(None)
            while True:
                c = s.recv(65536)
                if not c:
                    os._exit(0)
                sys.stdout.buffer.write(c); sys.stdout.flush()
        while not buf.endswith(b"\n"):
            c = s.recv(65536)
            if not c:
                break
            buf += c
    except OSError:
        out({"ok": False, "error": "bus core unavailable"}, 3)
    sys.stdout.write(buf.decode("utf-8", "replace")); sys.stdout.flush()
    try:
        os._exit(0 if json.loads(buf).get("ok") else 1)
    except ValueError:
        os._exit(1)


main()
