{
  "format": "uroboros-compiled-route/v1",
  "route_id": "integrity-dev.manifest-refresh",
  "version": 1,
  "safety": "write",
  "summary": "Refresh bytes, mode and sha256 of every file PUBLIC-EXPORT-MANIFEST.json already lists, in this working tree only; the manifest's previous blob is kept as {{manifest_blob}}",
  "params": {},
  "preconditions": [
    {"name": "at-repo-root", "argv": ["git", "rev-parse", "--show-prefix"], "expect": "\\A\\s*\\Z", "timeout_s": 10},
    {"name": "manifest-tracked", "argv": ["git", "ls-files", "--error-unmatch", "PUBLIC-EXPORT-MANIFEST.json"],
     "expect": "PUBLIC-EXPORT-MANIFEST\\.json", "timeout_s": 10}
  ],
  "backup": [
    {"name": "keep-manifest-blob", "argv": ["git", "hash-object", "-w", "PUBLIC-EXPORT-MANIFEST.json"],
     "extract": {"manifest_blob": "\\A([0-9a-f]{40,64})"}, "timeout_s": 15}
  ],
  "steps": [
    {"name": "refresh-manifest", "argv": ["python", "-B", ".github/scripts/update_manifest.py", "--root", "."],
     "writes": true, "timeout_s": 120},
    {"name": "show-change", "argv": ["git", "diff", "--stat", "--", "PUBLIC-EXPORT-MANIFEST.json"], "timeout_s": 15}
  ],
  "timeout_s": 300
}
