{
  "format": "uroboros-compiled-route/v1",
  "route_id": "integrity-dev.ci-tests",
  "version": 1,
  "safety": "read",
  "summary": "Test suites of the CI job passed against the distributions installed in {{work}}: root {{root_passed}} passed, components {{components_passed}} passed; the project's own runbooks validate; the tree is still clean",
  "params": {
    "work": "\\.\\./(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,63}"
  },
  "preconditions": [
    {"name": "at-repo-root", "argv": ["git", "rev-parse", "--show-prefix"], "expect": "\\A\\s*\\Z", "timeout_s": 10},
    {"name": "clean-tree", "argv": ["git", "status", "--porcelain", "--untracked-files=all"], "expect": "\\A\\Z",
     "timeout_s": 30},
    {"name": "no-pythonpath", "argv": ["python", "-B", ".github/scripts/route_tools.py", "unset", "PYTHONPATH"],
     "expect": "\\Aunset", "timeout_s": 10},
    {"name": "installed-profile", "argv": ["python", "-B", ".github/scripts/route_tools.py", "py-run",
     "--venv", "{{work}}/venv", "--exe", "guardian", "--", "version", "--all"], "timeout_s": 60}
  ],
  "steps": [
    {"name": "root-suite", "argv": ["python", "-B", ".github/scripts/route_tools.py", "py-run", "--venv", "{{work}}/venv",
     "--", "-B", "-m", "pytest", "-p", "no:cacheprovider", "--junitxml", "{{work}}/root-junit.xml"],
     "extract": {"root_passed": "(\\d+) passed"}, "timeout_s": 300},
    {"name": "own-runbooks-validate", "argv": ["python", "-B", ".github/scripts/route_tools.py", "py-run",
     "--venv", "{{work}}/venv", "--exe", "integrity-guards", "--", "runbooks", "validate", ".integrity/runbooks.json"],
     "timeout_s": 60},
    {"name": "component-suites", "argv": ["python", "-B", ".github/scripts/route_tools.py", "py-run",
     "--venv", "{{work}}/venv", "--glob", "components/*/tests", "--", "-B", "-m", "pytest",
     "-p", "no:cacheprovider", "--import-mode=importlib", "--junitxml", "{{work}}/components-junit.xml"],
     "extract": {"components_passed": "(\\d+) passed"}, "timeout_s": 300},
    {"name": "still-clean", "argv": ["git", "status", "--porcelain", "--untracked-files=all"], "expect": "\\A\\Z",
     "timeout_s": 30}
  ],
  "timeout_s": 900
}
