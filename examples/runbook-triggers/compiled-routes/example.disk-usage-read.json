{
  "format": "uroboros-compiled-route/v1",
  "route_id": "example.disk-usage-read",
  "version": 1,
  "safety": "read",
  "summary": "Invented example: reads the usage of the file system mounted at {{mount}}",
  "params": {"mount": "/[a-z0-9/_-]{0,60}"},
  "preconditions": [
    {"name": "mount-exists", "argv": ["test", "-d", "{{mount}}"], "timeout_s": 5}
  ],
  "steps": [
    {
      "name": "read-usage",
      "argv": ["df", "-P", "{{mount}}"],
      "extract": {"used_percent": "\\s(\\d{1,3})%\\s"},
      "timeout_s": 10
    }
  ],
  "timeout_s": 30
}
